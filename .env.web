# Standalone WEB shell (vite --mode web). Same-origin /api via Vite proxy in dev.
VITE_GNH_SHELL=web
# Empty = same origin (preferred with reverse proxy / Vite proxy).
VITE_API_URL=
VITE_API_BASE=
# Local E2E flags (VITE_WEB_DEV_LOGIN*) belong in .env.web.local — never in production builds.
# Production release: consent-gated Yandex Metrika (counter 114652319). Build-time flag.
VITE_GNH_METRIKA_ENABLED=1
