# Copy to server/.env.web-local (gitignored) after Setup-GnhWebLocal.ps1.
# Never point DATABASE_URL at gnh_supabase or Timeweb hosts.

PORT=3001
NODE_ENV=development
GNH_LOCAL_DATABASE=1
GNH_DISABLE_TELEGRAM_BOT=1
GNH_DISABLE_ADMIN_BROADCAST=1
GNH_WEB_ENABLED=1

# Filled by Setup when using embedded Postgres (default):
# DATABASE_URL=postgresql://gnh_local:gnh_local_dev@127.0.0.1:55432/gnh_web_local
DATABASE_URL=postgresql://gnh_local:gnh_local_dev@127.0.0.1:55432/gnh_web_local
GNH_EXPECT_HOST=127.0.0.1
GNH_EXPECT_DATABASE=gnh_web_local
GNH_EXPECT_USER=gnh_local

CORS_ORIGIN=http://localhost:5173
WEB_PUBLIC_ORIGIN=http://localhost:5173
WEB_COOKIE_SECURE=false
WEB_DEV_LOGIN_ENABLED=1
WEB_DEV_LOGIN_SECRET=local-e2e-dev-secret-not-for-prod
WEB_SESSION_TTL_HOURS=24

YOOKASSA_MOCK=1
YOOKASSA_SHOP_ID=local-mock-shop
YOOKASSA_SECRET_KEY=local-mock-secret
YOOKASSA_RETURN_URL_WEB=http://localhost:5173/premium?payment=return
YOOKASSA_WEBHOOK_SECRET=local-mock-webhook

# OIDC left empty for local E2E (use dev-login).
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:5173/api/web/auth/telegram/callback
TELEGRAM_BOT_TOKEN=000000000:LOCAL-E2E-FAKE-TOKEN
