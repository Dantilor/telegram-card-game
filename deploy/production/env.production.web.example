# Production co-host env deltas for WEB on the EXISTING Timeweb API.
# Merge into the current app env — do NOT create a second paid database/app unless required.
# Never commit real secrets.

# Keep existing:
# DATABASE_URL=.../gnh_supabase
# TELEGRAM_BOT_TOKEN=... (@GameNightHostBot)
# BOT_WEBHOOK_PATH=...
# YOOKASSA_SHOP_ID / YOOKASSA_SECRET_KEY (live)
# ADMIN_TOKEN=...
# CORS_ORIGIN=... (add WEB origin)

NODE_ENV=production
GNH_STAGING=0
TRUST_PROXY=1
WEB_COOKIE_SECURE=true
WEB_DEV_LOGIN_ENABLED=0

# --- WEB feature (owner private test first) ---
# Start with WEB off, then flip after migrations + OIDC:
GNH_WEB_ENABLED=0
GNH_SERVE_WEB_STATIC=0
GNH_WEB_STATIC_DIR=/app/dist-web

# After owner smoke, set:
# GNH_WEB_ENABLED=1
# GNH_SERVE_WEB_STATIC=1
# WEB_OWNER_TELEGRAM_IDS=<your_telegram_id>
# WEB_PUBLIC_ORIGIN=https://WEB-DOMAIN
# CORS_ORIGIN=<existing Mini App origins>,https://WEB-DOMAIN
# TELEGRAM_OIDC_CLIENT_ID=
# TELEGRAM_OIDC_CLIENT_SECRET=
# TELEGRAM_OIDC_REDIRECT_URI=https://WEB-DOMAIN/api/web/auth/telegram/callback
# TELEGRAM_OIDC_SCOPES=openid profile
# YOOKASSA_RETURN_URL_WEB=https://WEB-DOMAIN/premium?payment=return

# Rollback WEB without touching DB:
# GNH_WEB_ENABLED=0
# GNH_SERVE_WEB_STATIC=0
