# Production co-host env deltas for WEB on the EXISTING Timeweb app gamenight-api.
# Merge into the current app env — do NOT create a second paid database/app.
# Never commit real secrets. Keep existing DATABASE_URL (/gnh_supabase), bot token,
# BOT_WEBHOOK_PATH, live YooKassa keys, and ADMIN_TOKEN unchanged.

NODE_ENV=production
GNH_PRODUCTION=1
TIMEWEB=1
GNH_STAGING=0
TRUST_PROXY=1
WEB_COOKIE_SECURE=true
WEB_DEV_LOGIN_ENABLED=0

# --- Phase 1: ship API image with WEB built but OFF ---
GNH_WEB_ENABLED=0
GNH_SERVE_WEB_STATIC=0
# Timeweb Project dir=/server uses sidecar path:
GNH_WEB_STATIC_DIR=web-dist
# If switching to Dockerfile.production later:
# GNH_WEB_STATIC_DIR=/app/dist-web
GNH_BUILD_WEB=1

# Session limit OFF until Mini App + WEB clients both understand leases:
GNH_GAME_SESSION_LIMIT_ENABLED=0

# Device slot limit OFF for Phase A (schema 024 live; enforcement later):
GNH_WEB_DEVICE_LIMIT_ENABLED=0

# --- Phase 2: after DNS for play.gamenighthost.ru + migrations + smoke ---
# GNH_WEB_ENABLED=1
# GNH_SERVE_WEB_STATIC=1
# WEB_PUBLIC_ORIGIN=https://play.gamenighthost.ru
# CORS_ORIGIN=<existing Mini App origins>,https://play.gamenighthost.ru
# YOOKASSA_RETURN_URL_WEB=https://play.gamenighthost.ru/premium?payment=return

# Direct Timeweb SMTP (preferred). SMTP_RELAY_URL is NOT required.
# SMTP_ENABLED=1
# SMTP_HOST=smtp.timeweb.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@gamenighthost.ru
# SMTP_PASSWORD=<secret from Timeweb env only>
# SMTP_FROM=GameNight Host <noreply@gamenighthost.ru>
# Optional if both SMTP and relay are set: SMTP_TRANSPORT=smtp

# Optional later: enable concurrent game-session leases
# GNH_GAME_SESSION_LIMIT_ENABLED=1

# Notes:
# - WEB_OWNER_TELEGRAM_IDS does NOT protect anonymous WEB accounts.
# - Never enable WEB_EMAIL_OTP_ECHO / WEB_TELEGRAM_LINK_ECHO / YOOKASSA_MOCK in production.
# - Rollback WEB without DB changes: set GNH_WEB_ENABLED=0 and GNH_SERVE_WEB_STATIC=0.
# - DB migrations are TWO phases (never apply 023 by default):
#     npm run migrate:production-web:through-022
#     npm run migrate:production-web:activate-023   # needs CONFIRM_PRODUCTION_WEB_PLANS_ACTIVATE=YES
# - Before rolling API back to a pre-audience build (e.g. ac49d0c):
#     UPDATE plans SET is_active = false WHERE audience = 'web';
# - Identity: anonymous WEB session → optional email bind (registration) → /login recover.
#   Telegram link is optional secondary. Do not invent a second account system.
