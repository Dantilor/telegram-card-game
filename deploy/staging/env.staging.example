# Copy to deploy/staging/.env.staging (gitignored) and fill values.
# NEVER reuse production DATABASE_URL, YooKassa live shop, or @GameNightHostBot token.

PORT=3001
NODE_ENV=production
GNH_STAGING=1
GNH_ENV=staging
GNH_SERVE_WEB_STATIC=1
GNH_WEB_STATIC_DIR=/app/dist-web
GNH_DISABLE_TELEGRAM_BOT=1
GNH_DISABLE_ADMIN_BROADCAST=1
TRUST_PROXY=1

# Separate staging database only (name must NOT be gnh_supabase).
# Boot refuses any other DB name unless GNH_STAGING_DB_NAME matches.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gnh_web_staging?sslmode=require
GNH_STAGING_DB_NAME=gnh_web_staging

# Staging Telegram bot (NEW bot via BotFather — not GameNightHostBot).
TELEGRAM_BOT_TOKEN=

# OIDC Login Widget for the STAGING bot
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://STAGING-DOMAIN/api/web/auth/telegram/callback
TELEGRAM_OIDC_SCOPES=openid profile

WEB_PUBLIC_ORIGIN=https://STAGING-DOMAIN
CORS_ORIGIN=https://STAGING-DOMAIN
WEB_SESSION_TTL_HOURS=720
WEB_OIDC_STATE_TTL_MINUTES=10
WEB_SESSION_COOKIE_NAME=gnh_sid
WEB_CSRF_COOKIE_NAME=gnh_csrf
WEB_COOKIE_SECURE=true
WEB_DEV_LOGIN_ENABLED=0
WEB_DEV_LOGIN_SECRET=

# YooKassa TEST shop only
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://STAGING-DOMAIN/premium?payment=return
YOOKASSA_RETURN_URL_WEB=https://STAGING-DOMAIN/premium?payment=return
# Optional custom Authorization header check. Leave empty for staging —
# Premium still requires authenticated API payment verification.
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_WEBHOOK_REQUIRE_SECRET=0

# Staging-only admin token (random). Broadcasts remain disabled by GNH_STAGING.
ADMIN_TOKEN=
