# Free Timeweb App Stand for gamenight-api (branch feature/gnh-web-standalone).
# Keep production App settings unchanged:
#   Project directory: /server
#   Build: npm run build
#   Start: npm start
#   Health: /health
#
# Create the stand FROM feature/gnh-web-standalone.
# Do NOT copy production DATABASE_URL / live YooKassa / production ADMIN_TOKEN.

NODE_ENV=production
PORT=3001
TRUST_PROXY=1

# --- Hard isolation (required) ---
GNH_STAGING=1
GNH_ENV=staging
GNH_STAGING_DB_NAME=gnh_web_staging
# Must be a NON-production database name (never gnh_supabase):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gnh_web_staging?sslmode=require

# WEB same-origin (sidecar build copies into /server/web-dist)
GNH_BUILD_WEB=1
GNH_WEB_ENABLED=1
GNH_SERVE_WEB_STATIC=1
GNH_WEB_STATIC_DIR=web-dist

# Bot / broadcasts MUST stay off on the free stand
GNH_DISABLE_TELEGRAM_BOT=1
GNH_DISABLE_ADMIN_BROADCAST=1
WEB_DEV_LOGIN_ENABLED=0
WEB_COOKIE_SECURE=true

# Owner-only while testing (numeric Telegram user id)
WEB_OWNER_TELEGRAM_IDS=

# Public HTTPS origin of THIS stand (Timeweb issues the URL)
WEB_PUBLIC_ORIGIN=https://STAND-HOST
CORS_ORIGIN=https://STAND-HOST

# Separate staging Telegram bot (recommended) OR carefully scoped Login Widget
# on a test bot — do not point stand webhook at production BotFather webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://STAND-HOST/api/web/auth/telegram/callback
TELEGRAM_OIDC_SCOPES=openid profile

# YooKassa TEST shop only (optional on first stand smoke)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL_WEB=https://STAND-HOST/premium?payment=return
YOOKASSA_WEBHOOK_REQUIRE_SECRET=0
YOOKASSA_WEBHOOK_SECRET=

# Stand-only admin token (broadcasts still blocked by GNH_STAGING)
ADMIN_TOKEN=
