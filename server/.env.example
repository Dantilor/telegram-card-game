PORT=
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
CORS_ORIGIN=
ADMIN_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Mini App return after YooKassa redirect.
YOOKASSA_RETURN_URL=
# WEB browser return (defaults to ${WEB_PUBLIC_ORIGIN}/premium?payment=return).
YOOKASSA_RETURN_URL_WEB=
# Optional shared secret for webhook Authorization header. Even if empty,
# Premium is granted only after authenticated YooKassa API verification.
YOOKASSA_WEBHOOK_SECRET=
# Set 1 to reject webhooks when YOOKASSA_WEBHOOK_SECRET is empty (strict mode).
YOOKASSA_WEBHOOK_REQUIRE_SECRET=0

# --- GameNight Host WEB (Telegram OIDC + sessions) ---
# Client ID / Secret from @BotFather → Login Widget (OIDC).
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Must exactly match an Allowed URL / redirect URI registered in BotFather.
TELEGRAM_OIDC_REDIRECT_URI=https://WEB-DOMAIN/api/web/auth/telegram/callback
# Do not request phone or telegram:bot_access unless product requires them.
TELEGRAM_OIDC_SCOPES=openid profile
# Public browser origin for post-login redirect (same host as reverse-proxied /api).
WEB_PUBLIC_ORIGIN=https://WEB-DOMAIN
WEB_SESSION_TTL_HOURS=720
WEB_OIDC_STATE_TTL_MINUTES=10
WEB_SESSION_COOKIE_NAME=gnh_sid
WEB_CSRF_COOKIE_NAME=gnh_csrf
# Set false only for local http:// testing.
WEB_COOKIE_SECURE=true
# Local-only session mint (never enable in production).
WEB_DEV_LOGIN_ENABLED=0
WEB_DEV_LOGIN_SECRET=

# --- Staging / isolation (Timeweb WEB staging) ---
# GNH_STAGING=1 requires DATABASE_URL db name == GNH_STAGING_DB_NAME (default
# gnh_web_staging), refuses gnh_supabase, disables Telegram bot side-effects
# and admin broadcasts, and enables trust proxy by default.
# Migrations are NEVER auto-run on container start.
# GNH_STAGING=0
# GNH_STAGING_DB_NAME=gnh_web_staging
# GNH_DISABLE_TELEGRAM_BOT=0
# GNH_DISABLE_ADMIN_BROADCAST=0
# GNH_SERVE_WEB_STATIC=0
# GNH_WEB_STATIC_DIR=
# TRUST_PROXY=1
