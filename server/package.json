{
  "name": "telegram-card-game-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build-web-sidecar.mjs && tsc",
    "build:api": "tsc",
    "build:web-sidecar": "node scripts/build-web-sidecar.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test src/legal/legal.test.ts src/party/partyRules.test.ts src/auth/webAuth.test.ts src/payments/yookassaWebhook.test.ts src/config/runtimeFlags.test.ts src/db/stagingMigrations.test.ts scripts/build-web-sidecar.test.mjs",
    "migrate:staging": "node scripts/apply-staging-migrations.mjs",
    "migrate:staging:seed": "node scripts/apply-staging-migrations.mjs --seed",
    "migrate:staging:dry": "node scripts/apply-staging-migrations.mjs --dry-run",
    "migrate:production-web:dry": "node scripts/apply-production-web-migrations.mjs --dry-run",
    "migrate:production-web": "node scripts/apply-production-web-migrations.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jose": "^6.2.15",
    "pg": "^8.12.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "20.x"
  }
}
